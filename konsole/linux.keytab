keyboard "Linux 控制台"
key PgDown-Shift : "\E[6~"
key Right-Shift-Ansi : "\EC"
key Right-Shift+Ansi+AppCursorKeys : "\EOC"
key Right-Shift+Ansi-AppCursorKeys : "\E[C"
key Right+Shift : "\E[1;5C"
key Down-Shift-Ansi : "\EB"
key Down-Shift+Ansi+AppCursorKeys : "\EOB"
key Down-Shift+Ansi-AppCursorKeys : "\E[B"
key Down+Shift : ScrollLineDown
key Left-Shift-Ansi : "\ED"
key Left-Shift+Ansi+AppCursorKeys : "\EOD"
key Left-Shift+Ansi-AppCursorKeys : "\E[D"
key Left+Shift : "\E[1;5D"
key Up+Shift : "\E[1;2A"
key Up-Shift-Ansi : "\EA"
key Up-Shift+Ansi+AppCursorKeys : "\EOA"
key Up-Shift+Ansi-AppCursorKeys : "\E[A"
key Home : "\E[1~"
key F11 : "\E[23~"
key F12 : "\E[24~"
key F9 : "\E[20~"
key F10 : "\E[21~"
key F7 : "\E[18~"
key F8 : "\E[19~"
key F5 : "\E[[E"
key F6 : "\E[17~"
key F3 : "\E[[C"
key F4 : "\E[[D"
key F1 : "\E[[A"
key F2 : "\E[[B"
key Ins-Shift : "\E[2~"
key Del : "\E[3~"
key Return-NewLine : "\r"
key Return+NewLine : "\r\n"
key Enter+NewLine : "\r\n"
key Enter-NewLine : "\r"
key Backspace : "\x7f"
key Esc : "\E"
key Tab : "\t"
key PgUp-Shift : "\E[5~"
